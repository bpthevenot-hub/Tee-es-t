# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# HubSpot
HUBSPOT_API_KEY=pat-...

# Gmail — le token s'obtient une fois avec `python setup_gmail.py` (navigateur requis)
# Option A : chemin vers le fichier credentials.json (client OAuth)
GMAIL_CREDENTIALS_PATH=./config/gmail_credentials.json
# Option B : coller le JSON du client OAuth directement (pour Railway/Render)
GMAIL_CREDENTIALS_JSON=
# Cron / CI / cloud : coller le contenu de config/gmail_token.json
# (sans token valide, les outils Gmail renvoient une erreur au lieu d'attendre un navigateur)
GMAIL_TOKEN_JSON=

# Notion
NOTION_API_KEY=ntn_...

# GitHub (Personal Access Token avec permissions repo, issues, pull_requests)
# GH_TOKEN est utilise si GITHUB_TOKEN est vide
GITHUB_TOKEN=ghp_...

# Configuration agent
AGENT_OWNER_NAME=Baptiste Thevenot
AGENT_OWNER_EMAIL=bp.thevenot@gmail.com
HUBSPOT_OWNER_ID=80842560

# Emplacements (optionnel) — chemins relatifs resolus depuis la racine du projet
# agent.log, reports/, livrables/ (defaut : racine du projet)
# AGENT_DATA_DIR=
# Statut du site (defaut : ../docs/status.json, racine du site dans Tee-es-t)
# AGENT_STATUS_FILE=
# Token Gmail (defaut : config/gmail_token.json)
# GMAIL_TOKEN_PATH=
