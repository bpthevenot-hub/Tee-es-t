{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'AUTO_MODE_ACTIVE: Executer /auto — activer tous les connecteurs, scanner CRM, rapport flash, mode operateur autonome.'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/vive-memoire-stop.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "playwright-mcp"
    }
  }
}
